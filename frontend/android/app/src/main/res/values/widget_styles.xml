<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Numbers. API 24-25 launchers can't load font resources in a widget,
         so they get the system monospace; values-v26 swaps in bundled DM Mono. -->
    <style name="WidgetMono">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:maxLines">1</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Small uppercase labels, muted grey, 11sp. -->
    <style name="WidgetLabel">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/widget_label</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="WidgetMeta">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/widget_label</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="WidgetBar" parent="android:Widget.Material.ProgressBar.Horizontal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">6dp</item>
        <item name="android:minHeight">6dp</item>
        <item name="android:maxHeight">6dp</item>
        <item name="android:max">100</item>
        <item name="android:indeterminate">false</item>
    </style>
</resources>
