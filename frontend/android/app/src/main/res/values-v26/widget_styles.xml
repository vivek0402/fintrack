<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 8+: numbers in the bundled DM Mono (res/font), as in the app. -->
    <style name="WidgetMono">
        <item name="android:fontFamily">@font/dm_mono_medium</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:maxLines">1</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="WidgetLabel">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/widget_label</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="WidgetMeta">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/widget_label</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="WidgetBar" parent="android:Widget.Material.ProgressBar.Horizontal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">6dp</item>
        <item name="android:minHeight">6dp</item>
        <item name="android:maxHeight">6dp</item>
        <item name="android:max">100</item>
        <item name="android:indeterminate">false</item>
    </style>
</resources>
