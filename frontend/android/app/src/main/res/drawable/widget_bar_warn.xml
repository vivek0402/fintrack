<?xml version="1.0" encoding="utf-8"?>
<!-- 6dp rounded progress bar: white-8% track, warn fill. A scale (not clip)
     drawable keeps the fill's rounded end. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="@color/widget_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%" android:scaleGravity="left|center_vertical">
            <shape android:shape="rectangle">
                <corners android:radius="3dp" />
                <solid android:color="@color/widget_warn" />
            </shape>
        </scale>
    </item>
</layer-list>
