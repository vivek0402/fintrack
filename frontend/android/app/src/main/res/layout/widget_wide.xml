<?xml version="1.0" encoding="utf-8"?>
<!-- B) Wide 4x2. Default texts are sample values: this file is also the
     widget picker's previewLayout. WidgetRenderer overwrites every one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_header"
            style="@style/WidgetLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FinTrack · September" />

        <FrameLayout
            android:id="@+id/widget_plus"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_plus_circle"
            android:contentDescription="@string/widget_add_transaction">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_plus" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/widget_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/WidgetLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_label_spent_today" />

                <TextView
                    android:id="@+id/widget_today_amount"
                    style="@style/WidgetMono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="₹1,240"
                    android:textSize="20sp" />

                <TextView
                    style="@style/WidgetLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/widget_label_this_month" />

                <TextView
                    android:id="@+id/widget_month_amount"
                    style="@style/WidgetMono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="₹26,600"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/widget_month_of"
                    style="@style/WidgetMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="₹14,040 of ₹18,000 budgeted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_budgets"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:layout_weight="1.25"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/widget_row_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/widget_row_1_name"
                            style="@style/WidgetMeta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Shopping"
                            android:textColor="@color/widget_text"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/widget_row_1_amount"
                            style="@style/WidgetMono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="₹640 over"
                            android:textColor="@color/widget_over"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="4dp">

                        <ProgressBar
                            android:id="@+id/widget_row_1_bar_ok"
                            style="@style/WidgetBar"
                            android:progress="100"
                            android:progressDrawable="@drawable/widget_bar_ok"
                            android:visibility="gone" />

                        <ProgressBar
                            android:id="@+id/widget_row_1_bar_warn"
                            style="@style/WidgetBar"
                            android:progress="100"
                            android:progressDrawable="@drawable/widget_bar_warn"
                            android:visibility="gone" />

                        <ProgressBar
                            android:id="@+id/widget_row_1_bar_over"
                            style="@style/WidgetBar"
                            android:progress="100"
                            android:progressDrawable="@drawable/widget_bar_over"
                            android:visibility="visible" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_row_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/widget_row_2_name"
                            style="@style/WidgetMeta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Fun"
                            android:textColor="@color/widget_text"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/widget_row_2_amount"
                            style="@style/WidgetMono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="₹100 left"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="4dp">

                        <ProgressBar
                            android:id="@+id/widget_row_2_bar_ok"
                            style="@style/WidgetBar"
                            android:progress="95"
                            android:progressDrawable="@drawable/widget_bar_ok"
                            android:visibility="gone" />

                        <ProgressBar
                            android:id="@+id/widget_row_2_bar_warn"
                            style="@style/WidgetBar"
                            android:progress="95"
                            android:progressDrawable="@drawable/widget_bar_warn"
                            android:visibility="visible" />

                        <ProgressBar
                            android:id="@+id/widget_row_2_bar_over"
                            style="@style/WidgetBar"
                            android:progress="95"
                            android:progressDrawable="@drawable/widget_bar_over"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_row_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/widget_row_3_name"
                            style="@style/WidgetMeta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Food"
                            android:textColor="@color/widget_text"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/widget_row_3_amount"
                            style="@style/WidgetMono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="₹2,100 left"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="4dp">

                        <ProgressBar
                            android:id="@+id/widget_row_3_bar_ok"
                            style="@style/WidgetBar"
                            android:progress="74"
                            android:progressDrawable="@drawable/widget_bar_ok"
                            android:visibility="visible" />

                        <ProgressBar
                            android:id="@+id/widget_row_3_bar_warn"
                            style="@style/WidgetBar"
                            android:progress="74"
                            android:progressDrawable="@drawable/widget_bar_warn"
                            android:visibility="gone" />

                        <ProgressBar
                            android:id="@+id/widget_row_3_bar_over"
                            style="@style/WidgetBar"
                            android:progress="74"
                            android:progressDrawable="@drawable/widget_bar_over"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_no_budgets"
                    style="@style/WidgetMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:text="@string/widget_no_budgets"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_signed_out"
            style="@style/WidgetMeta"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/widget_signed_out"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Manual refresh tap target: full width, 32dp tall. -->
    <TextView
        android:id="@+id/widget_footer"
        style="@style/WidgetMeta"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:text="Updated 9:32 am · tap to refresh"
        android:textSize="11sp" />
</LinearLayout>
