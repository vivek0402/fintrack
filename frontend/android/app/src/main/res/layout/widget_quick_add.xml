<?xml version="1.0" encoding="utf-8"?>
<!-- C) Quick-add bar 4x1. Default texts are sample values: this file is also
     the widget picker's previewLayout. WidgetRenderer overwrites them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <FrameLayout
        android:id="@+id/widget_plus"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_plus_circle"
        android:contentDescription="@string/widget_add_transaction">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_plus" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/widget_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_add_transaction"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_subtitle"
            style="@style/WidgetMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/widget_quick_add_hint" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_today_col"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            style="@style/WidgetLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_label_today" />

        <TextView
            android:id="@+id/widget_today_amount"
            style="@style/WidgetMono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="₹1,240"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
