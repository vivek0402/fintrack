<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base launch theme — Compose owns all real theming via ui/theme/Theme.kt.
         This XML theme only controls the system splash/launch background before
         Compose takes over, per standard Compose-on-Android practice. -->
    <style name="Theme.FinTrackNative" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/amoled_black</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/amoled_black</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/amoled_black</item>
    </style>
</resources>
